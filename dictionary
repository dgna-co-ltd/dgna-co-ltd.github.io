<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Từ Điển Thuật Ngữ Quản Trị Dữ Liệu — DGNA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --gold:       #C9A84C;
    --gold-light: #E8C97A;
    --gold-dim:   #7A6228;
    --gold-pale:  #F5EDD6;
    --black:      #0E0E0E;
    --gray-900:   #1A1A1A;
    --gray-800:   #242424;
    --gray-700:   #333333;
    --gray-600:   #4A4A4A;
    --gray-400:   #888888;
    --gray-200:   #D4D4D4;
    --gray-100:   #EFEFEF;
    --gray-50:    #F8F7F5;
    --white:      #FAFAF8;
    --radius:     6px;
    --radius-lg:  12px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Outfit', sans-serif;
    background: var(--black);
    color: var(--white);
    min-height: 100vh;
    font-size: 15px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Noise texture overlay ── */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
    pointer-events: none; z-index: 0;
  }

  /* ── Layout ── */
  .site-wrap { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 0 2rem; }

  /* ── Header ── */
  header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--gray-800);
    display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem;
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: 1rem; }
  .brand-mark {
    width: 40px; height: 40px;
    border: 1.5px solid var(--gold);
    display: grid; place-items: center;
    font-family: 'DM Mono', monospace;
    font-size: 11px; font-weight: 500;
    color: var(--gold); letter-spacing: .08em;
    flex-shrink: 0;
  }
  .brand-name {
    font-family: 'DM Mono', monospace;
    font-size: 12px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--gray-400);
  }
  .hero-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.05;
    color: var(--white);
    letter-spacing: -.02em;
  }
  .hero-title em { color: var(--gold); font-style: italic; }
  .hero-meta {
    font-size: 12px; color: var(--gray-400);
    font-family: 'DM Mono', monospace;
    letter-spacing: .05em;
    display: flex; gap: 1.5rem; flex-wrap: wrap;
  }
  .hero-meta span::before { content: '— '; }

  /* ── Controls bar ── */
  .controls {
    position: sticky; top: 0; z-index: 50;
    background: rgba(14,14,14,.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--gray-800);
    padding: 1rem 0;
  }
  .controls-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 2rem;
    display: flex; gap: .75rem; align-items: center; flex-wrap: wrap;
  }
  .search-wrap {
    flex: 1; min-width: 220px; position: relative;
  }
  .search-wrap svg {
    position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
    width: 15px; height: 15px; stroke: var(--gray-400); fill: none;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    pointer-events: none;
  }
  #search {
    width: 100%; padding: 9px 12px 9px 36px;
    background: var(--gray-900); border: 1px solid var(--gray-700);
    border-radius: var(--radius); color: var(--white);
    font-family: 'Outfit', sans-serif; font-size: 14px;
    outline: none; transition: border-color .2s;
  }
  #search:focus { border-color: var(--gold); }
  #search::placeholder { color: var(--gray-600); }

  .filter-pills { display: flex; gap: .5rem; flex-wrap: wrap; }
  .pill {
    padding: 7px 14px; border-radius: 999px;
    font-size: 12px; font-weight: 500; letter-spacing: .04em;
    cursor: pointer; transition: all .18s; user-select: none;
    border: 1px solid var(--gray-700); color: var(--gray-400);
    background: transparent; font-family: 'Outfit', sans-serif;
  }
  .pill:hover { border-color: var(--gray-400); color: var(--white); }
  .pill.active { background: var(--gold); border-color: var(--gold); color: var(--black); }
  .pill[data-cat="gov"].active   { background: #2D7A4F; border-color: #2D7A4F; color: #fff; }
  .pill[data-cat="mgmt"].active  { background: #185FA5; border-color: #185FA5; color: #fff; }
  .pill[data-cat="tech"].active  { background: #8A5C00; border-color: #8A5C00; color: #fff; }
  .pill[data-cat="risk"].active  { background: #8B1A1A; border-color: #8B1A1A; color: #fff; }

  .count-label {
    margin-left: auto; font-size: 12px; color: var(--gray-400);
    font-family: 'DM Mono', monospace; white-space: nowrap;
  }

  /* ── Main grid ── */
  main { padding: 2.5rem 0 5rem; }

  .group-block { margin-bottom: 3.5rem; }
  .group-header {
    display: flex; align-items: center; gap: 1rem;
    margin-bottom: 1.25rem; padding-bottom: .75rem;
    border-bottom: 1px solid var(--gray-800);
  }
  .group-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .group-dot.gov  { background: #2D7A4F; }
  .group-dot.mgmt { background: #185FA5; }
  .group-dot.tech { background: #C9A84C; }
  .group-dot.risk { background: #C0392B; }
  .group-title {
    font-family: 'DM Mono', monospace;
    font-size: 11px; letter-spacing: .15em;
    text-transform: uppercase; color: var(--gray-400);
  }
  .group-count {
    margin-left: auto; font-family: 'DM Mono', monospace;
    font-size: 11px; color: var(--gray-600);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1px;
    background: var(--gray-800);
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .card {
    background: var(--gray-900);
    padding: 1.5rem;
    cursor: pointer;
    transition: background .15s;
    position: relative;
  }
  .card:hover { background: var(--gray-800); }
  .card.expanded { background: var(--gray-800); }

  .card-top { display: flex; gap: .75rem; align-items: flex-start; }
  .card-code {
    font-family: 'DM Mono', monospace;
    font-size: 10px; color: var(--gray-600);
    letter-spacing: .08em; flex-shrink: 0;
    margin-top: 3px;
  }
  .card-names { flex: 1; }
  .card-en {
    font-size: 15px; font-weight: 500; color: var(--white);
    line-height: 1.3; margin-bottom: 3px;
  }
  .card-vi {
    font-size: 13px; color: var(--gray-400); line-height: 1.3;
  }
  .card-abbr {
    font-family: 'DM Mono', monospace;
    font-size: 11px; font-weight: 500;
    color: var(--gold); padding: 3px 8px;
    border: 1px solid var(--gold-dim);
    border-radius: 4px; flex-shrink: 0;
    align-self: flex-start; margin-top: 2px;
    background: rgba(201,168,76,.08);
  }

  .card-expand-icon {
    width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px;
    color: var(--gray-600); transition: transform .2s, color .15s;
  }
  .card.expanded .card-expand-icon { transform: rotate(45deg); color: var(--gold); }

  .card-body {
    max-height: 0; overflow: hidden;
    transition: max-height .3s ease, opacity .25s ease;
    opacity: 0;
  }
  .card.expanded .card-body { max-height: 400px; opacity: 1; }

  .card-body-inner { padding-top: 1rem; border-top: 1px solid var(--gray-800); margin-top: 1rem; }

  .desc-text {
    font-size: 13.5px; color: var(--gray-200); line-height: 1.7;
    margin-bottom: 1rem;
  }

  .meta-rows { display: flex; flex-direction: column; gap: .5rem; }
  .meta-row { display: flex; gap: .75rem; align-items: flex-start; }
  .meta-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--gray-600);
    width: 72px; flex-shrink: 0; padding-top: 1px;
  }
  .meta-val { font-size: 12.5px; color: var(--gray-300); line-height: 1.5; }
  .meta-val.law-tag { color: var(--gold-light); }
  .meta-val.syn-tag { font-style: italic; color: var(--gray-400); }

  /* ── Empty state ── */
  .empty {
    text-align: center; padding: 5rem 2rem;
    display: none;
  }
  .empty.show { display: block; }
  .empty-icon { font-size: 2.5rem; margin-bottom: 1rem; opacity: .4; }
  .empty-msg { color: var(--gray-600); font-size: 14px; }

  /* ── Footer ── */
  footer {
    border-top: 1px solid var(--gray-800);
    padding: 2rem 0;
  }
  .footer-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 2rem;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem;
  }
  .footer-brand {
    font-family: 'DM Mono', monospace;
    font-size: 11px; letter-spacing: .1em; color: var(--gray-600);
  }
  .footer-note { font-size: 12px; color: var(--gray-700); }

  /* ── Highlight match ── */
  mark {
    background: rgba(201,168,76,.25);
    color: var(--gold-light);
    border-radius: 2px; padding: 0 1px;
  }

  /* ── Scroll to top ── */
  #top-btn {
    position: fixed; bottom: 2rem; right: 2rem;
    width: 40px; height: 40px; z-index: 100;
    background: var(--gray-800); border: 1px solid var(--gray-700);
    border-radius: 50%; cursor: pointer;
    display: grid; place-items: center;
    opacity: 0; pointer-events: none;
    transition: opacity .2s, background .15s;
  }
  #top-btn.show { opacity: 1; pointer-events: all; }
  #top-btn:hover { background: var(--gray-700); }
  #top-btn svg { width: 16px; height: 16px; stroke: var(--gray-400); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .site-wrap, .controls-inner, .footer-inner { padding: 0 1rem; }
    header { flex-direction: column; align-items: flex-start; padding: 2rem 0 1.5rem; }
    .cards-grid { grid-template-columns: 1fr; }
    .hero-meta { gap: .75rem; }
  }

  /* ── Fade in animation ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .group-block { animation: fadeUp .4s ease both; }
  .group-block:nth-child(1) { animation-delay: .05s; }
  .group-block:nth-child(2) { animation-delay: .10s; }
  .group-block:nth-child(3) { animation-delay: .15s; }
  .group-block:nth-child(4) { animation-delay: .20s; }
</style>
</head>
<body>

<div class="site-wrap">
  <header>
    <div>
      <div class="brand" style="margin-bottom:1.25rem">
        <div class="brand-mark">DG</div>
        <div class="brand-name">DGNA.VN</div>
      </div>
      <h1 class="hero-title">Từ Điển<br><em>Thuật Ngữ</em><br>Quản Trị Dữ Liệu</h1>
    </div>
    <div class="hero-meta">
      <span>55 thuật ngữ</span>
      <span>Chuẩn DAMA-DMBOK</span>
      <span>Đối chiếu pháp luật Việt Nam</span>
    </div>
  </header>
</div>

<div class="controls">
  <div class="controls-inner">
    <div class="search-wrap">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search" type="text" placeholder="Tìm kiếm thuật ngữ, viết tắt, mô tả...">
    </div>
    <div class="filter-pills">
      <button class="pill active" data-cat="all">Tất cả</button>
      <button class="pill" data-cat="gov">Quản trị</button>
      <button class="pill" data-cat="mgmt">Quản lý DL</button>
      <button class="pill" data-cat="tech">Kỹ thuật</button>
      <button class="pill" data-cat="risk">Tuân thủ</button>
    </div>
    <span class="count-label" id="count-label">55 thuật ngữ</span>
  </div>
</div>

<div class="site-wrap">
  <main id="main-content"></main>
  <div class="empty" id="empty-state">
    <div class="empty-icon">◎</div>
    <p class="empty-msg">Không tìm thấy thuật ngữ phù hợp</p>
  </div>
</div>

<footer>
  <div class="footer-inner">
    <span class="footer-brand">DGNA.VN — Data Governance & Architecture Vietnam</span>
    <span class="footer-note">Dựa trên DAMA-DMBOK 2nd Edition · Luật Dữ liệu 60/2024/QH15 · Luật BVDLCN 91/2025/QH15 · QĐ 2439/QĐ-TTg</span>
  </div>
</footer>

<button id="top-btn" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Lên đầu trang">
  <svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<script>
const TERMS = [
  {id:"DG-001",cat:"gov",en:"Data Governance",vi:"Quản trị dữ liệu",desc:"Việc thực thi quyền lực, kiểm soát và ra quyết định chung (lập kế hoạch, giám sát, thực thi) về quản lý tài sản dữ liệu của tổ chức.",abbr:"DG",law:"Luật Dữ liệu 60/2024/QH15; QĐ 2439/QĐ-TTg",syn:"Data Stewardship (nghĩa rộng)"},
  {id:"DG-002",cat:"gov",en:"Data Asset",vi:"Tài sản dữ liệu",desc:"Dữ liệu được tổ chức xác định là có giá trị kinh tế, vận hành hoặc chiến lược, cần được quản lý và bảo vệ.",abbr:"",law:"Luật Dữ liệu 60/2024/QH15",syn:"Data Resource"},
  {id:"DG-003",cat:"gov",en:"Data Policy",vi:"Chính sách dữ liệu",desc:"Tập hợp các quy tắc, nguyên tắc chỉ đạo việc thu thập, sử dụng, chia sẻ và bảo vệ dữ liệu trong tổ chức.",abbr:"",law:"QĐ 2439/QĐ-TTg; Luật Dữ liệu 60/2024/QH15",syn:""},
  {id:"DG-004",cat:"gov",en:"Data Strategy",vi:"Chiến lược dữ liệu",desc:"Kế hoạch tổng thể xác định mục tiêu, tầm nhìn, ưu tiên và lộ trình phát triển năng lực dữ liệu của tổ chức.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:""},
  {id:"DG-005",cat:"gov",en:"Data Council",vi:"Hội đồng Dữ liệu",desc:"Cơ quan ra quyết định cấp cao về dữ liệu trong tổ chức, gồm các lãnh đạo đại diện cho nghiệp vụ và kỹ thuật. Phê duyệt chính sách, giải quyết xung đột về dữ liệu.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:"Data Governance Board, Data Steering Committee"},
  {id:"DG-006",cat:"gov",en:"Chief Data Officer",vi:"Giám đốc Dữ liệu",desc:"Lãnh đạo cấp C chịu trách nhiệm toàn bộ chiến lược và quản trị dữ liệu của tổ chức.",abbr:"CDO",law:"QĐ 2439/QĐ-TTg",syn:""},
  {id:"DG-007",cat:"gov",en:"Data Owner",vi:"Chủ quản dữ liệu / Người sở hữu dữ liệu",desc:"Cá nhân/đơn vị thuộc nghiệp vụ chịu trách nhiệm về ý nghĩa, chất lượng và quyết định sử dụng một tập dữ liệu cụ thể.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:"Data Accountable"},
  {id:"DG-008",cat:"gov",en:"Data Steward",vi:"Người quản lý dữ liệu",desc:"Người thực hiện các nhiệm vụ quản trị dữ liệu hàng ngày: định nghĩa, giám sát chất lượng, duy trì metadata, điều phối giữa nghiệp vụ và IT.",abbr:"",law:"",syn:""},
  {id:"DG-009",cat:"gov",en:"Business Glossary",vi:"Từ điển nghiệp vụ",desc:"Tập hợp các thuật ngữ nghiệp vụ được định nghĩa thống nhất, được phê duyệt bởi Data Owner, làm chuẩn chung cho toàn tổ chức.",abbr:"",law:"QĐ 2439/QĐ-TTg (Từ điển dữ liệu quốc gia)",syn:"Enterprise Glossary"},
  {id:"DG-010",cat:"gov",en:"Data Accountability",vi:"Trách nhiệm giải trình về dữ liệu",desc:"Nghĩa vụ của cá nhân/đơn vị chịu trách nhiệm trước tổ chức khi dữ liệu sai, thiếu hoặc bị lạm dụng.",abbr:"",law:"Luật Dữ liệu 60/2024/QH15; NĐ 13/2023/NĐ-CP",syn:""},
  {id:"DG-011",cat:"gov",en:"Data Decision Rights",vi:"Quyền quyết định về dữ liệu",desc:"Xác định ai có thẩm quyền ra quyết định về dữ liệu, trong tình huống nào và theo quy trình nào.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:"Data Authority"},
  {id:"DG-012",cat:"gov",en:"Data Capability Landscape",vi:"Khung năng lực dữ liệu",desc:"Mô hình tổng thể mô tả các năng lực cần có để tổ chức quản trị và khai thác dữ liệu hiệu quả, từ chiến lược đến vận hành.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:"Data Capability Framework"},
  {id:"DG-013",cat:"gov",en:"Data Maturity",vi:"Mức độ trưởng thành về dữ liệu",desc:"Mức độ phát triển năng lực dữ liệu của tổ chức, thường được đo theo thang điểm từ 1 (sơ khai) đến 5 (tối ưu hóa).",abbr:"",law:"",syn:"Data Capability Maturity"},
  {id:"DG-014",cat:"gov",en:"DCAM",vi:"Mô hình đánh giá năng lực quản lý dữ liệu",desc:"Khung đánh giá mức độ trưởng thành dữ liệu do EDM Council phát triển, tập trung vào tuân thủ và kiểm soát rủi ro dữ liệu.",abbr:"DCAM",law:"",syn:"Data Management Capability Assessment Model"},
  {id:"DG-015",cat:"gov",en:"TOGAF",vi:"Khung kiến trúc tổng thể doanh nghiệp",desc:"Khung kiến trúc doanh nghiệp (The Open Group Architecture Framework) kết nối dữ liệu, công nghệ và nghiệp vụ quản lý.",abbr:"TOGAF",law:"",syn:"The Open Group Architecture Framework"},
  {id:"DG-016",cat:"gov",en:"Data Adoption Rate",vi:"Tỷ lệ áp dụng quản trị dữ liệu",desc:"Mức độ các đơn vị/cá nhân trong tổ chức thực sự tuân thủ và sử dụng các chính sách, quy trình quản trị dữ liệu đã ban hành.",abbr:"",law:"",syn:""},
  {id:"DM-001",cat:"mgmt",en:"Data Management",vi:"Quản lý dữ liệu",desc:"Tổng thể các hoạt động lập kế hoạch, kiểm soát và cung cấp để thu thập, lưu trữ, bảo vệ và khai thác dữ liệu hiệu quả theo DAMA-DMBOK.",abbr:"DM",law:"Luật Dữ liệu 60/2024/QH15",syn:""},
  {id:"DM-002",cat:"mgmt",en:"Metadata",vi:"Siêu dữ liệu",desc:"Dữ liệu mô tả dữ liệu khác. Bao gồm siêu dữ liệu nghiệp vụ, kỹ thuật, vận hành và truy gốc.",abbr:"",law:"QĐ 2439/QĐ-TTg; Luật Dữ liệu 60/2024/QH15",syn:""},
  {id:"DM-003",cat:"mgmt",en:"Metadata Management",vi:"Quản lý siêu dữ liệu",desc:"Quá trình tạo lập, duy trì và quản lý toàn bộ siêu dữ liệu của tổ chức, bao gồm từ điển dữ liệu, danh mục dữ liệu và lineage.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:""},
  {id:"DM-004",cat:"mgmt",en:"Data Dictionary",vi:"Từ điển dữ liệu",desc:"Kho lưu trữ mô tả chi tiết về các phần tử dữ liệu: tên, định nghĩa, kiểu dữ liệu, nguồn gốc, quy tắc nghiệp vụ và mối quan hệ.",abbr:"",law:"QĐ 2439/QĐ-TTg (Từ điển dữ liệu quốc gia)",syn:"Data Element Dictionary"},
  {id:"DM-005",cat:"mgmt",en:"Data Catalog",vi:"Danh mục dữ liệu",desc:"Hệ thống kiểm kê và tìm kiếm tài sản dữ liệu của tổ chức, tích hợp metadata, lineage, phân loại và thông tin chủ quản.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:"Data Inventory"},
  {id:"DM-006",cat:"mgmt",en:"Data Quality",vi:"Chất lượng dữ liệu",desc:"Mức độ dữ liệu đáp ứng các tiêu chí: chính xác, đầy đủ, nhất quán, kịp thời, duy nhất và hợp lệ để phục vụ mục đích sử dụng.",abbr:"DQ",law:"Luật Dữ liệu 60/2024/QH15",syn:""},
  {id:"DM-007",cat:"mgmt",en:"Data Lineage",vi:"Nguồn gốc / Truy gốc dữ liệu",desc:"Khả năng truy vết toàn bộ hành trình của dữ liệu từ nguồn gốc qua các phép chuyển đổi đến đích cuối, đảm bảo tính minh bạch và kiểm toán.",abbr:"",law:"Luật Dữ liệu 60/2024/QH15",syn:"Data Provenance, Data Traceability"},
