  {id:"DM-009",cat:"mgmt",en:"Master Data Management",vi:"Quản lý dữ liệu Chủ",desc:"Quy trình và công nghệ đảm bảo dữ liệu chủ được tạo lập, chuẩn hóa, đồng bộ và phân phối thống nhất trên toàn tổ chức.",abbr:"MDM",law:"QĐ 2439/QĐ-TTg",syn:""},
  {id:"DM-010",cat:"mgmt",en:"Reference Data",vi:"Dữ liệu Tham chiếu",desc:"Tập hợp các giá trị được chuẩn hóa dùng để phân loại hoặc mô tả dữ liệu khác, ví dụ: danh mục mã quốc gia, danh mục ngành nghề.",abbr:"RD",law:"QĐ 2439/QĐ-TTg",syn:""},
  {id:"DM-011",cat:"mgmt",en:"Reference Data Management",vi:"Quản lý dữ liệu Tham chiếu",desc:"Quản lý các danh mục, bảng mã dùng chung nhằm đảm bảo nhất quán về phân loại dữ liệu trong toàn tổ chức.",abbr:"RDM",law:"QĐ 2439/QĐ-TTg",syn:""},
  {id:"DM-012",cat:"mgmt",en:"Data Architecture",vi:"Kiến trúc dữ liệu",desc:"Thiết kế tổng thể định nghĩa cách dữ liệu được thu thập, lưu trữ, tích hợp, quản lý và sử dụng trong tổ chức.",abbr:"",law:"QĐ 2439/QĐ-TTg (Khung Kiến trúc dữ liệu quốc gia)",syn:""},
  {id:"DM-013",cat:"mgmt",en:"Data Model",vi:"Mô hình dữ liệu",desc:"Biểu diễn trừu tượng cấu trúc và mối quan hệ giữa các phần tử dữ liệu, bao gồm mô hình khái niệm, logic và vật lý.",abbr:"",law:"",syn:""},
  {id:"DM-014",cat:"mgmt",en:"Data Domain",vi:"Miền dữ liệu",desc:"Nhóm các tài sản dữ liệu liên quan theo chủ đề nghiệp vụ, ví dụ: Customer, Product, Finance. Là đơn vị tổ chức cơ bản trong data governance.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:"Data Subject Area"},
  {id:"DM-015",cat:"mgmt",en:"Data Lifecycle Management",vi:"Quản lý vòng đời dữ liệu",desc:"Quản lý dữ liệu qua toàn bộ vòng đời: tạo lập, lưu trữ, sử dụng, chia sẻ, lưu trữ lâu dài và xóa bỏ.",abbr:"DLM",law:"Luật Dữ liệu 60/2024/QH15",syn:""},
  {id:"DM-016",cat:"mgmt",en:"Data Integration",vi:"Tích hợp dữ liệu",desc:"Quy trình kết hợp dữ liệu từ nhiều nguồn khác nhau thành một cái nhìn thống nhất, phục vụ phân tích và vận hành.",abbr:"",law:"Luật Dữ liệu 60/2024/QH15",syn:"Data Interoperability (nghĩa rộng)"},
  {id:"DM-017",cat:"mgmt",en:"Data Taxonomy",vi:"Phân loại dữ liệu / Bản đồ dữ liệu",desc:"Hệ thống phân cấp và phân loại dữ liệu theo các tiêu chí nhất định, giúp tổ chức và tìm kiếm dữ liệu hiệu quả.",abbr:"",law:"QĐ 2439/QĐ-TTg",syn:"Data Classification Scheme"},
  {id:"DM-018",cat:"mgmt",en:"Data Reconciliation",vi:"Đối chiếu / Cân đối dữ liệu",desc:"Quá trình so sánh và kiểm tra tính nhất quán của dữ liệu giữa các hệ thống hoặc nguồn khác nhau để phát hiện sai lệch.",abbr:"",law:"",syn:""},
  {id:"DM-019",cat:"mgmt",en:"Data as a Service",vi:"Dữ liệu như một dịch vụ",desc:"Mô hình cung cấp dữ liệu qua API hoặc nền tảng trung tâm, cho phép các đơn vị tiêu thụ dữ liệu theo nhu cầu mà không cần quản lý hạ tầng.",abbr:"DaaS",law:"",syn:""},
  {id:"DM-020",cat:"mgmt",en:"Data Democratization",vi:"Dân chủ hóa dữ liệu",desc:"Quá trình mở rộng khả năng truy cập và sử dụng dữ liệu cho toàn bộ nhân viên nghiệp vụ, không chỉ riêng bộ phận IT.",abbr:"",law:"",syn:""},
  {id:"DM-021",cat:"mgmt",en:"Customer Data",vi:"Dữ liệu khách hàng",desc:"Tập hợp dữ liệu mô tả khách hàng của tổ chức, bao gồm thông tin định danh, giao dịch, hành vi và tương tác.",abbr:"",law:"NĐ 13/2023/NĐ-CP; Luật BVDLCN 91/2025/QH15",syn:""},
  {id:"DM-022",cat:"mgmt",en:"Data Element",vi:"Phần tử dữ liệu / Điểm dữ liệu",desc:"Đơn vị dữ liệu nhỏ nhất có ý nghĩa trong một hệ thống, được định nghĩa rõ về tên, kiểu, định dạng và nghĩa nghiệp vụ.",abbr:"",law:"",syn:"Data Field, Data Attribute"},
