  {id:"DM-024",cat:"mgmt",en:"Data Warehouse",vi:"Kho dữ liệu",desc:"Hệ thống lưu trữ dữ liệu tích hợp từ nhiều nguồn, được tổ chức theo chủ đề và tối ưu hóa cho truy vấn phân tích.",abbr:"DWH",law:"",syn:""},
  {id:"TE-001",cat:"tech",en:"ETL (Extract, Transform, Load)",vi:"Trích xuất – Chuyển đổi – Nạp dữ liệu",desc:"Quy trình kỹ thuật trích xuất dữ liệu từ nguồn, chuyển đổi theo quy tắc nghiệp vụ và nạp vào hệ thống đích.",abbr:"ETL",law:"",syn:"ELT (biến thể hiện đại)"},
  {id:"TE-002",cat:"tech",en:"Change Data Capture",vi:"Bắt thay đổi dữ liệu",desc:"Kỹ thuật theo dõi và ghi nhận các thay đổi trong cơ sở dữ liệu nguồn để đồng bộ dữ liệu theo thời gian thực.",abbr:"CDC",law:"",syn:""},
  {id:"TE-003",cat:"tech",en:"Data Lake / Lakehouse",vi:"Hồ dữ liệu / Kho-hồ dữ liệu",desc:"Nền tảng lưu trữ tập trung lượng lớn dữ liệu thô ở định dạng gốc. Lakehouse kết hợp tính linh hoạt của Data Lake với khả năng truy vấn của Data Warehouse.",abbr:"",law:"",syn:""},
  {id:"TE-004",cat:"tech",en:"Data Platform",vi:"Nền tảng dữ liệu",desc:"Hệ sinh thái công nghệ tích hợp phục vụ toàn bộ vòng đời dữ liệu, từ thu thập, xử lý, lưu trữ đến phân tích và phân phối.",abbr:"",law:"",syn:""},
  {id:"TE-005",cat:"tech",en:"Personally Identifiable Information",vi:"Dữ liệu cá nhân / Thông tin nhận dạng cá nhân",desc:"Bất kỳ thông tin nào có thể được sử dụng để xác định danh tính một cá nhân cụ thể, trực tiếp hoặc gián tiếp.",abbr:"PII",law:"NĐ 13/2023/NĐ-CP; Luật BVDLCN 91/2025/QH15",syn:"Personal Data (GDPR)"},
  {id:"TE-006",cat:"tech",en:"Data Security",vi:"Bảo mật dữ liệu",desc:"Tổng thể các biện pháp kỹ thuật và quản lý bảo vệ dữ liệu khỏi truy cập trái phép, rò rỉ, thay đổi hoặc phá hủy.",abbr:"",law:"Luật An ninh mạng; NĐ 13/2023/NĐ-CP; Luật BVDLCN 91/2025/QH15",syn:""},
  {id:"TE-007",cat:"tech",en:"Sensitive Zone",vi:"Vùng dữ liệu nhạy cảm",desc:"Phân vùng lưu trữ dữ liệu có mức độ bảo mật cao nhất, chứa PII và dữ liệu kinh doanh chiến lược, được kiểm soát truy cập nghiêm ngặt.",abbr:"",law:"NĐ 13/2023/NĐ-CP; Luật BVDLCN 91/2025/QH15",syn:""},
  {id:"TE-008",cat:"tech",en:"Real-time Data",vi:"Dữ liệu thời gian thực",desc:"Dữ liệu được xử lý và cung cấp ngay lập tức hoặc gần như ngay lập tức sau khi sự kiện xảy ra, độ trễ thường dưới vài giây.",abbr:"",law:"",syn:"Streaming Data"},
  {id:"TE-009",cat:"tech",en:"Big Data",vi:"Dữ liệu lớn",desc:"Tập dữ liệu có khối lượng, tốc độ, đa dạng vượt quá khả năng xử lý của hệ thống truyền thống, đặc trưng bởi 3V hoặc 5V.",abbr:"",law:"",syn:""},
  {id:"TE-010",cat:"tech",en:"Data API",vi:"Giao diện lập trình ứng dụng dữ liệu",desc:"Giao diện cho phép các ứng dụng truy cập và trao đổi dữ liệu theo chuẩn, thường qua REST hoặc GraphQL.",abbr:"API",law:"",syn:""},
  {id:"TE-011",cat:"tech",en:"Unstructured Data",vi:"Dữ liệu phi cấu trúc",desc:"Dữ liệu không có định dạng hoặc lược đồ xác định trước, như văn bản tự do, hình ảnh, âm thanh, video.",abbr:"",law:"",syn:""},
  {id:"RC-001",cat:"risk",en:"Data Compliance",vi:"Tuân thủ dữ liệu",desc:"Đảm bảo hoạt động thu thập, xử lý và lưu trữ dữ liệu tuân theo các quy định pháp luật, tiêu chuẩn ngành và chính sách nội bộ.",abbr:"",law:"Luật Dữ liệu 60/2024/QH15; Luật BVDLCN 91/2025/QH15; NĐ 13/2023/NĐ-CP",syn:""},
  {id:"RC-002",cat:"risk",en:"Personal Data Protection",vi:"Bảo vệ dữ liệu cá nhân",desc:"Tổng thể biện pháp pháp lý và kỹ thuật bảo vệ quyền riêng tư và dữ liệu cá nhân của người dùng.",abbr:"BVDLCN",law:"Luật BVDLCN 91/2025/QH15; NĐ 13/2023/NĐ-CP",syn:"Data Privacy"},
  {id:"RC-003",cat:"risk",en:"Consent",vi:"Sự đồng ý / Chấp thuận",desc:"Sự cho phép rõ ràng của chủ thể dữ liệu cho phép tổ chức thu thập, xử lý dữ liệu cá nhân của họ theo mục đích đã nêu.",abbr:"",law:"NĐ 13/2023/NĐ-CP; Luật BVDLCN 91/2025/QH15",syn:""},
  {id:"RC-004",cat:"risk",en:"Cross-border Data Transfer",vi:"Chuyển giao dữ liệu xuyên biên giới",desc:"Việc truyền, chia sẻ hoặc cung cấp dữ liệu ra ngoài lãnh thổ quốc gia nơi dữ liệu được thu thập.",abbr:"",law:"NĐ 13/2023/NĐ-CP; Luật BVDLCN 91/2025/QH15",syn:""},
  {id:"RC-005",cat:"risk",en:"Data Breach",vi:"Vi phạm dữ liệu / Rò rỉ dữ liệu",desc:"Sự cố bảo mật dẫn đến truy cập, tiết lộ, thay đổi hoặc phá hủy dữ liệu trái phép, gây tổn hại cho tổ chức hoặc cá nhân.",abbr:"",law:"NĐ 13/2023/NĐ-CP; Luật BVDLCN 91/2025/QH15",syn:"Data Incident"},
  {id:"RC-006",cat:"risk",en:"GDPR",vi:"Quy định bảo vệ dữ liệu chung (EU)",desc:"Quy định bảo vệ dữ liệu cá nhân của Liên minh châu Âu, có hiệu lực từ 2018. Áp dụng cho mọi tổ chức xử lý dữ liệu công dân EU.",abbr:"GDPR",law:"",syn:"General Data Protection Regulation"},
  {id:"RC-007",cat:"risk",en:"Data Audit",vi:"Kiểm toán dữ liệu",desc:"Đánh giá độc lập và có hệ thống về tính chính xác, đầy đủ, bảo mật và tuân thủ của dữ liệu và quy trình quản lý dữ liệu.",abbr:"",law:"Luật Dữ liệu 60/2024/QH15; QĐ 2439/QĐ-TTg",syn:"Data Assessment"},
  {id:"RC-008",cat:"risk",en:"Data Incident",vi:"Sự cố dữ liệu",desc:"Sự kiện bất thường ảnh hưởng đến tính sẵn sàng, toàn vẹn hoặc bảo mật của dữ liệu, cần được xử lý theo quy trình ứng phó sự cố.",abbr:"",law:"NĐ 13/2023/NĐ-CP",syn:"Data Breach (trường hợp có rò rỉ)"},
];

const CATS = {
  gov:  {label:"Quản trị",        dot:"gov"},
  mgmt: {label:"Quản lý dữ liệu", dot:"mgmt"},
  tech: {label:"Kỹ thuật / Hạ tầng", dot:"tech"},
  risk: {label:"Tuân thủ / Rủi ro",  dot:"risk"},
};

let currentCat = 'all';
let currentQ   = '';

function esc(s) {
  return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function highlight(text, q) {
  if (!q) return esc(text);
  const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return esc(text).replace(new RegExp('(' + escaped + ')', 'gi'), '<mark>$1</mark>');
}

function renderCard(term, q) {
  const hasAbbr = term.abbr;
  const hasLaw  = term.law;
  const hasSyn  = term.syn;
  return `
    <div class="card" id="${term.id}" onclick="toggleCard(this)">
      <div class="card-top">
        <span class="card-code">${esc(term.id)}</span>
        <div class="card-names">
          <div class="card-en">${highlight(term.en, q)}</div>
          <div class="card-vi">${highlight(term.vi, q)}</div>
        </div>
        ${hasAbbr ? `<span class="card-abbr">${esc(term.abbr)}</span>` : ''}
        <svg class="card-expand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </div>
      <div class="card-body">
        <div class="card-body-inner">
          <p class="desc-text">${highlight(term.desc, q)}</p>
          <div class="meta-rows">
            ${hasLaw ? `<div class="meta-row"><span class="meta-label">Pháp luật</span><span class="meta-val law-tag">${esc(term.law)}</span></div>` : ''}
            ${hasSyn ? `<div class="meta-row"><span class="meta-label">Đồng nghĩa</span><span class="meta-val syn-tag">${esc(term.syn)}</span></div>` : ''}
            ${hasAbbr ? `<div class="meta-row"><span class="meta-label">Viết tắt</span><span class="meta-val" style="font-family:'DM Mono',monospace;color:var(--gold)">${esc(term.abbr)}</span></div>` : ''}
          </div>
        </div>
      </div>
    </div>`;
}

function toggleCard(el) {
  el.classList.toggle('expanded');
}

function render() {
  const q = currentQ.toLowerCase().trim();
  const filtered = TERMS.filter(t => {
    const catMatch = currentCat === 'all' || t.cat === currentCat;
    const text = [t.id,t.en,t.vi,t.desc,t.abbr,t.law,t.syn].join(' ').toLowerCase();
    const qMatch = !q || text.includes(q);
    return catMatch && qMatch;
  });

  document.getElementById('count-label').textContent = filtered.length + ' thuật ngữ';

  const main = document.getElementById('main-content');
  const empty = document.getElementById('empty-state');

  if (filtered.length === 0) {
    main.innerHTML = '';
    empty.classList.add('show');
    return;
  }
  empty.classList.remove('show');

  // Group by cat preserving order
  const groups = {};
  filtered.forEach(t => {
    if (!groups[t.cat]) groups[t.cat] = [];
    groups[t.cat].push(t);
  });

  const catOrder = ['gov','mgmt','tech','risk'];
  let html = '';
  catOrder.forEach(cat => {
    if (!groups[cat]) return;
    const info = CATS[cat];
    const items = groups[cat];
    html += `<div class="group-block">
      <div class="group-header">
        <span class="group-dot ${info.dot}"></span>
        <span class="group-title">${esc(info.label)}</span>
        <span class="group-count">${items.length}</span>
      </div>
      <div class="cards-grid">
        ${items.map(t => renderCard(t, q)).join('')}
      </div>
    </div>`;
  });
  main.innerHTML = html;
}

// Search
let searchTimer;
document.getElementById('search').addEventListener('input', e => {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => {
    currentQ = e.target.value;
    render();
  }, 160);
});

// Filters
document.querySelectorAll('.pill').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentCat = btn.dataset.cat;
    render();
  });
});

// Scroll-to-top
const topBtn = document.getElementById('top-btn');
window.addEventListener('scroll', () => {
  topBtn.classList.toggle('show', window.scrollY > 400);
}, {passive: true});

// Init
render();
</script>
